#!/bin/sh
# Require an explicitly reviewed manifest update whenever release files change.
# This hook intentionally does not run repository-controlled signing code or
# access the maintainer's private key.
set -eu

ROOT="$(git rev-parse --show-toplevel)"
MANIFEST="capsule-integrity.json"

guarded() {
  git diff --cached --name-only --diff-filter=ACMR | grep -v "^$MANIFEST$" || true
}

ambiguous() {
  for f in $(guarded); do
    if git diff --name-only -- "$f" | grep -qx "$f"; then
      echo "pre-commit: '$f' has staged AND unstaged changes; commit or stash the unstaged part first so the manifest refresh is unambiguous." >&2
      return 0
    fi
  done
  return 1
}

if [ -z "$(guarded)" ]; then
  exit 0
fi

if ambiguous; then
  exit 1
fi

echo "pre-commit: linting…"
( cd "$ROOT" && node tools/lint.mjs )

if ! git diff --cached --name-only -- "$MANIFEST" | grep -qx "$MANIFEST"; then
  echo "pre-commit: release files changed but $MANIFEST is not staged." >&2
  echo "Run 'npm run integrity', inspect the manifest, and stage it explicitly." >&2
  exit 1
fi

echo "pre-commit: guarded files and an explicit manifest update are staged."
