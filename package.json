{
  "name": "local-chat",
  "version": "1.8.1",
  "description": "Local AI chat app + OpenAI-compatible API server for Ollama models, exposed locally or via a Cloudflare tunnel.",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "bash start-portable.sh",
    "local": "bash start-portable.sh",
    "server": "node server.mjs --mode local",
    "test": "node --test",
    "lint": "node tools/lint.mjs",
    "ui-probe": "node tools/ui-probes.mjs",
    "lint:fix": "node tools/lint.mjs",
    "tunnel": "node server.mjs --mode tunnel",
    "tunnel:tailscale": "node server.mjs --mode tunnel --tunnel-type tailscale",
    "tunnel:named": "node server.mjs --mode tunnel --tunnel-type named",
    "ci": "npm test && node tools/generate-integrity.mjs --check && git diff --exit-code",
    "models": "node tools/model-cli.mjs list --url http://127.0.0.1:11435",
    "integrity": "node tools/generate-integrity.mjs",
    "integrity:check": "node tools/generate-integrity.mjs --check",
    "hooks:install": "git config core.hooksPath .githooks && echo 'Hooks installed (.githooks/).'",
    "runtimes:package": "node tools/package-runtimes.mjs",
    "model:balanced": "node tools/model-cli.mjs pull hf.co/prithivMLmods/Qwen3-4B-2507-abliterated-GGUF:Q4_K_M --url http://127.0.0.1:11435",
    "model:portable": "node tools/model-cli.mjs pull huihui_ai/gemma3-abliterated:1b --url http://127.0.0.1:11435",
    "model:reasoning": "node tools/model-cli.mjs pull dolphin3:8b-llama3.1-q4_K_M --url http://127.0.0.1:11435",
    "model:coding": "node tools/model-cli.mjs pull dolphin-mistral:7b --url http://127.0.0.1:11435",
    "model:vision": "node tools/model-cli.mjs pull huihui_ai/gemma3-abliterated:4b --url http://127.0.0.1:11435",
    "model:qwythos": "node tools/model-cli.mjs pull hf.co/huihui-ai/Huihui-Qwythos-9B-Claude-Mythos-5-1M-abliterated-GGUF:Q6_K --url http://127.0.0.1:11435",
    "model:deepseek-r1": "node tools/model-cli.mjs pull hf.co/tensorblock/DeepSeek-R1-Distill-Qwen-14B-abliterated-v2-GGUF:Q4_K_M --url http://127.0.0.1:11435",
    "model:gpt-oss": "node tools/model-cli.mjs pull hf.co/mradermacher/gpt-oss-20b-heretic-ara-v3-GGUF:MXFP4_MOE --url http://127.0.0.1:11435",
    "model:qwen36-moe": "node tools/model-cli.mjs pull hf.co/llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-GGUF:Q3_K_M --url http://127.0.0.1:11435",
    "model:qwopus": "node tools/model-cli.mjs pull hf.co/mradermacher/Qwopus3.6-27B-v1-Abliterated-preview-GGUF:Q4_K_M --url http://127.0.0.1:11435",
    "model:dolphin-mixtral": "node tools/model-cli.mjs pull dolphin-mixtral:8x7b-v2.7-q2_K --url http://127.0.0.1:11435"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {}
}
